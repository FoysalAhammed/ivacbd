# ─────────────────────────────────────────────────────────────────────────
#  IVAC License Backend — environment variables
#  Copy this file to `.env.local` for local dev, and set the same keys in the
#  Vercel dashboard (Project → Settings → Environment Variables) for production.
#
#  ⚠ NEVER commit a real .env.local. NEVER expose non-NEXT_PUBLIC_* values to
#    the browser, the Chrome extension, or the customer website bundle.
# ─────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ───────────────────────────────────────────────────────────
# Full SRV connection string from Atlas → Connect → Drivers. Include the db
# name in the path, e.g. .../ivac_license?retryWrites=true&w=majority
# SERVER-ONLY. Must never reach any frontend/extension bundle.
MONGODB_URI=mongodb+srv://username:password@cluster0.fdsafd.mongodb.net/
MONGODB_DB=ivac 
# ── License signing (asymmetric, ECDSA P-256 / ES256) ────────────────────────
# Generate with:  npm run gen:keys
# The PRIVATE key lives ONLY here / in Vercel — never in the extension.
# The matching PUBLIC key is embedded in extension/src/license.js + background.js.
LICENSE_SIGNING_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY
LICENSE_SIGNING_PUBLIC_KEY=BASE64_SPKI_PUBLIC_KEY
# Rotating keys? Bump the id so old signed licenses can be distinguished.
LICENSE_SIGNING_KEY_ID=k1

# ── Admin authentication ─────────────────────────────────────────────────────
# Random 32+ byte secret used to sign admin session cookies (HMAC).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=fdagdsfagfdsagfdsa
# One-time token that authorizes creating the FIRST admin via /api/admin/bootstrap.
# Set a long random value, create your admin, then DELETE this var.
ADMIN_BOOTSTRAP_TOKEN=fdasfgdsfagfdsagfdsag

# ── License key at-rest encryption (AES-256-GCM) ─────────────────────────────
# Encrypts each license key so an admin can re-reveal the full key later from
# the dashboard, WITHOUT storing plaintext in MongoDB. Optional: if unset, the
# code falls back to ADMIN_AUTH_SECRET. Generate a dedicated one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠ Keep this STABLE forever — changing it makes already-issued keys un-revealable.
LICENSE_KEY_ENC_SECRET=CHANGE_ME_RANDOM_32_BYTES

# ── OTP relay (Android app → backend → extension) ────────────────────────────
# Shared key the Android OTP app must send with every submit. Prevents strangers
# from injecting fake OTPs. Baked into the APK (see android/README.md). Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Fails CLOSED: if unset, /api/otp/submit rejects everything.
OTP_APP_KEY=CHANGE_ME_RANDOM_APP_KEY
# HMAC secret used to derive the phone routing key (raw numbers are never stored).
# Optional: falls back to ADMIN_AUTH_SECRET if unset. Keep STABLE. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PHONE_HMAC_SECRET=CHANGE_ME_RANDOM_32_BYTES

# ── Public config (safe to expose to the browser) ───────────────────────────
# The origin the customer website + extension call for the API. In production
# this is your Vercel URL, e.g. https://ivac-license.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000
# Shown in the purchase modal so customers know where to send bKash payment.
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
# Product name shown on the site + admin.
NEXT_PUBLIC_PRODUCT_NAME=IVAC Slot Automation Pro

# ── Licensing behavior (server-authoritative, tunable) ───────────────────────
# How long a signed license is trusted offline before the extension must
# re-validate (hours). ~24h per spec.
LICENSE_VALIDATION_INTERVAL_HOURS=24
# If the backend is unreachable at validation time, keep a legitimate customer
# working this long past nextValidationAt before hard-disabling (hours).
OFFLINE_GRACE_PERIOD_HOURS=72

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of extra origins allowed to call the public APIs
# (the customer website's own origin is always allowed). The Chrome extension
# sends no Origin we can trust, so license endpoints do not rely on Origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
